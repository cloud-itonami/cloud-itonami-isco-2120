(ns quant.store
  "SSoT for the ISCO-08 2120 community mathematicians, actuaries &
  statisticians actor (itonami actor pattern, ADR-2607011000 /
  AGENTS.md Actors section). Modeled on cloud-itonami-isco-4311's
  bookkeeping.store.

  Domain:

    client — a registered organization (:client-id, :name)
    model  — a registered analysis model {:model-id :client-id :name
             :significance-threshold number
             :approved-methods #{method-str}}.
             `:significance-threshold` is the registered alpha a
             reported p-value must not exceed to claim significance;
             `:approved-methods` is the registered set a proposed
             analysis's method must belong to (no undisclosed
             methodology swap after the fact).
    record — a committed operating record (approved analysis
             finding) — written ONLY via commit-record!.
    ledger — append-only audit trail, commit or hold."
  )

(defprotocol Store
  (client [s client-id])
  (model [s model-id])
  (records-of [s client-id])
  (ledger [s])
  (register-client! [s client])
  (register-model! [s m])
  (commit-record! [s record])
  (append-ledger! [s fact]))

(defrecord MemStore [a]
  Store
  (client [_ client-id] (get-in @a [:clients client-id]))
  (model [_ model-id] (get-in @a [:models model-id]))
  (records-of [_ client-id] (filter #(= client-id (:client-id %)) (:records @a)))
  (ledger [_] (:ledger @a))
  (register-client! [s client]
    (swap! a assoc-in [:clients (:client-id client)] client) s)
  (register-model! [s m]
    (swap! a assoc-in [:models (:model-id m)] m) s)
  (commit-record! [s record]
    (swap! a update :records (fnil conj []) record) s)
  (append-ledger! [s fact]
    (swap! a update :ledger (fnil conj []) fact) s))

(defn mem-store
  ([] (mem-store {}))
  ([seed] (->MemStore (atom (merge {:clients {} :models {} :records [] :ledger []}
                                   seed)))))
